@model WorldBuilderPlatform.WorldImage

@{
    ViewBag.Title = "Delete Image";
}

<h2>Delete Image</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this image?
</div>

<div class="card mb-4">
    <div class="card-body">
        <img src="@Model.img_url"
             style="max-width: 300px; border-radius: 8px;" />

        <p class="mt-3">@Model.description</p>
    </div>

    <div class="card-footer">
        @using (Html.BeginForm("DeleteConfirmed", "WorldImages", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.image_id" />

            <button type="submit" class="btn btn-danger">Delete</button>

            @Html.ActionLink(
                "Cancel",
                "Details",
                "Universes",
                new { id = ViewBag.UniverseId },
                new { @class = "btn btn-secondary" }
            )
        }
    </div>
</div>