@model WorldBuilderPlatform.WorldImage

@{
    ViewBag.Title = "Edit Image";
}

<h2>Edit Image</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("Edit", "WorldImages", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.image_id" />

    <div class="card mb-4">
        <div class="card-header">
            <h4>Image information</h4>
        </div>

        <div class="card-body">
            <div class="form-group mb-3">
                <label>Album name</label>
                <input type="text" name="albumName" value="@ViewBag.AlbumName" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Album description</label>
                <textarea name="albumDescription" class="form-control" rows="4">@ViewBag.AlbumDescription</textarea>
            </div>

            <div class="form-group mb-3">
                <label>Image description</label>
                <textarea name="imageDescription" class="form-control" rows="6">@Model.description</textarea>
            </div>

            <div class="form-group mb-3">
                <label>Change image</label>
                <input type="file" name="imageFile" class="form-control" />
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>

            @Html.ActionLink(
                "Cancel",
                "Details",
                "Universes",
                new { id = ViewBag.UniverseId },
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
}