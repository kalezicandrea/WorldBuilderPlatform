@model WorldBuilderPlatform.Review

@{
    ViewBag.Title = "Delete Review";
}

<div class="container mt-4">

    <h2>Delete Review</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this review?
    </div>

    <div class="card mb-4">

        <div class="card-header">
            <h4>Review</h4>
        </div>

        <div class="card-body">
            <p>
                <strong>Rating:</strong> @Model.rating / 5
            </p>

            <p>
                <strong>Comment:</strong>
            </p>

            <p>
                @Model.text
            </p>
        </div>

        <div class="card-footer">
            @using (Html.BeginForm("DeleteConfirmed", "Reviews", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.review_id" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Details",
                    "Universes",
                    new { id = ViewBag.UniverseId },
                    new { @class = "btn btn-secondary" }
                )
            }
        </div>

    </div>

</div>