@model WorldBuilderPlatform.StorySegment

@{
    ViewBag.Title = "Edit Story Segment";
}

<h2>Edit Story Segment</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("Edit", "StorySegments", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.segment_id" />

    <div class="card mb-4">
        <div class="card-header">
            <h4>Story segment information</h4>
        </div>

        <div class="card-body">
            <div class="form-group mb-3">
                <label>Title</label>
                <input type="text" name="title" value="@Model.title" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Content</label>
                <textarea name="content" class="form-control" rows="12">@Model.content</textarea>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Save Changes</button>

            @Html.ActionLink(
                "Cancel",
                "Details",
                "Universes",
                new { id = Model.universe_id },
                new { @class = "btn btn-secondary" }
            )
        </div>
    </div>
}