@model IEnumerable<WorldBuilderPlatform.Universe>
@using System.Collections.Generic
@using System.Linq

@{
    ViewBag.Title = "Home";

    var ratings = ViewBag.Ratings as Dictionary<int, decimal>;
    var favoriteCounts = ViewBag.FavoriteCounts as Dictionary<int, int>;
    var reviewCounts = ViewBag.ReviewCounts as Dictionary<int, int>;

    var allTags = ViewBag.AllTags;
    var allGenders = ViewBag.AllGenders;
    var allSpecies = ViewBag.AllSpecies;

    bool isAdmin = ViewBag.IsAdmin == true;
    var allUsers = ViewBag.AllUsers;

    int[] selectedTagIds = ViewBag.SelectedTagIds as int[] ?? new int[0];
    string[] selectedGenders = ViewBag.SelectedGenders as string[] ?? new string[0];
    int[] selectedSpeciesIds = ViewBag.SelectedSpeciesIds as int[] ?? new int[0];

    string selectedCategory = ViewBag.Category as string ?? "universe";
    string selectedSort = ViewBag.SortBy as string ?? "newest";
}

<div class="home-page">

    <aside class="search-sidebar">

        <h4>Search</h4>

        @using (Html.BeginForm("Index", "Home", FormMethod.Get))
        {
            <div class="form-group mb-3">
                <label for="searchText">Search text</label>
                <input type="text"
                       name="searchText"
                       id="searchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search..." />
            </div>

            <div class="form-group mb-3">
                <label for="category">Category</label>
                <select name="category" id="category" class="form-control">
                    <option value="universe" @(selectedCategory == "universe" ? "selected" : "")>Universe</option>
                    <option value="character" @(selectedCategory == "character" ? "selected" : "")>Character</option>
                    <option value="story" @(selectedCategory == "story" ? "selected" : "")>Story Segment</option>
                    <option value="location" @(selectedCategory == "location" ? "selected" : "")>Location</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="sortBy">Organize by</label>
                <select name="sortBy" id="sortBy" class="form-control">
                    <option value="newest" @(selectedSort == "newest" ? "selected" : "")>Newest to oldest</option>
                    <option value="oldest" @(selectedSort == "oldest" ? "selected" : "")>Oldest to newest</option>
                    <option value="mostReviews" @(selectedSort == "mostReviews" ? "selected" : "")>Number of reviews: most to least</option>
                    <option value="leastReviews" @(selectedSort == "leastReviews" ? "selected" : "")>Number of reviews: least to most</option>
                    <option value="bestRating" @(selectedSort == "bestRating" ? "selected" : "")>Rating: best to worst</option>
                    <option value="worstRating" @(selectedSort == "worstRating" ? "selected" : "")>Rating: worst to best</option>
                    <option value="mostFavorites" @(selectedSort == "mostFavorites" ? "selected" : "")>Favorites: most to least</option>
                    <option value="leastFavorites" @(selectedSort == "leastFavorites" ? "selected" : "")>Favorites: least to most</option>
                </select>
            </div>

            <hr />

            if (Session["user_id"] != null)
            {
                <div class="form-check mb-2">
                    <input type="checkbox"
                           name="myUniverses"
                           value="true"
                           class="form-check-input"
                           id="myUniverses"
                           @(ViewBag.MyUniverses == true ? "checked" : "") />

                    <label class="form-check-label" for="myUniverses">
                        My Universes
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox"
                           name="myFavorites"
                           value="true"
                           class="form-check-input"
                           id="myFavorites"
                           @(ViewBag.MyFavorites == true ? "checked" : "") />

                    <label class="form-check-label" for="myFavorites">
                        My Favorites
                    </label>
                </div>
            }

            <hr />

            <div id="tagFilters">
                <h5>Tags</h5>

                @if (allTags == null || allTags.Count == 0)
                {
                    <p class="text-muted">No tags yet.</p>
                }
                else
                {
                    foreach (var tag in allTags)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   name="selectedTagIds"
                                   value="@tag.tag_id"
                                   class="form-check-input"
                                   id="tag_@tag.tag_id"
                                   @(selectedTagIds.Contains((int)tag.tag_id) ? "checked" : "") />

                            <label class="form-check-label" for="tag_@tag.tag_id">
                                @tag.name
                            </label>
                        </div>
                    }
                }
            </div>

            <div id="characterFilters">
                <h5>Gender</h5>

                @if (allGenders == null || allGenders.Count == 0)
                {
                    <p class="text-muted">No genders yet.</p>
                }
                else
                {
                    foreach (var gender in allGenders)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   name="selectedGenders"
                                   value="@gender"
                                   class="form-check-input"
                                   id="gender_@gender"
                                   @(selectedGenders.Contains((string)gender) ? "checked" : "") />

                            <label class="form-check-label" for="gender_@gender">
                                @gender
                            </label>
                        </div>
                    }
                }

                <h5 class="mt-3">Species</h5>

                @if (allSpecies == null || allSpecies.Count == 0)
                {
                    <p class="text-muted">No species yet.</p>
                }
                else
                {
                    foreach (var species in allSpecies)
                    {
                        <div class="form-check">
                            <input type="checkbox"
                                   name="selectedSpeciesIds"
                                   value="@species.species_id"
                                   class="form-check-input"
                                   id="species_@species.species_id"
                                   @(selectedSpeciesIds.Contains((int)species.species_id) ? "checked" : "") />

                            <label class="form-check-label" for="species_@species.species_id">
                                @species.name
                            </label>
                        </div>
                    }
                }
            </div>

            <hr />

            <button type="submit" class="btn btn-primary w-100">
                Apply filters
            </button>

            <a href="@Url.Action("Index", "Home")"
               class="btn btn-secondary w-100 mt-2">
                Clear filters
            </a>
        }

    </aside>

    <main class="home-results">

        <h2>Explore Universes</h2>

        @if (!Model.Any())
        {
            <div class="alert alert-info">
                No universes found.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var universe in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                        <div class="card h-100 universe-card">

                            @if (!string.IsNullOrEmpty(universe.cover_img_url))
                            {
                                <img src="@universe.cover_img_url"
                                     class="card-img-top universe-card-img"
                                     alt="@universe.name" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/ImagesDesign/default-universe.jpg")"
                                     class="card-img-top universe-card-img"
                                     alt="Default universe image" />
                            }

                            <div class="card-body">
                                <h5 class="card-title">@universe.name</h5>

                                <p class="card-text">
                                    @{
                                        var description = universe.description ?? "";
                                        var shortDescription = description.Length > 120
                                            ? description.Substring(0, 120) + "..."
                                            : description;
                                    }

                                    @shortDescription
                                </p>

                                <p class="text-muted">
                                    Author: @universe.User.username
                                </p>

                                <p>
                                    <strong>Rating:</strong>
                                    @(ratings != null && ratings.ContainsKey(universe.universe_id)
                                        ? ratings[universe.universe_id]
                                        : 0)
                                </p>

                                <p>
                                    <strong>Reviews:</strong>
                                    @(reviewCounts != null && reviewCounts.ContainsKey(universe.universe_id)
                                        ? reviewCounts[universe.universe_id]
                                        : 0)
                                </p>

                                <p>
                                    <strong>Favorites:</strong>
                                    @(favoriteCounts != null && favoriteCounts.ContainsKey(universe.universe_id)
                                        ? favoriteCounts[universe.universe_id]
                                        : 0)
                                </p>

                                <p>
                                    <strong>Visibility:</strong> @universe.visibility
                                </p>

                                @Html.ActionLink(
                                    "View details",
                                    "Details",
                                    "Universes",
                                    new { id = universe.universe_id },
                                    new { @class = "btn btn-primary" }
                                )
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </main>

    @if (isAdmin)
    {
        <aside class="admin-users-sidebar">
            <h4>Registered Users</h4>

            @if (allUsers == null || allUsers.Count == 0)
            {
                <p class="text-muted">No users found.</p>
            }
            else
            {
                <div class="admin-users-list">
                    @foreach (var user in allUsers)
                    {
                        <div class="admin-user-card">
                            <strong>@user.username</strong>

                            <div class="text-muted">
                                @user.email
                            </div>

                            <div>
                                <small>Role ID: @user.role_id</small>
                            </div>

                            <div>
                                <small>Created: @user.created_at.ToString("dd.MM.yyyy")</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    }

</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categorySelect = document.getElementById("category");
            const tagFilters = document.getElementById("tagFilters");
            const characterFilters = document.getElementById("characterFilters");

            function updateFilterVisibility() {
                const category = categorySelect.value;

                if (category === "universe") {
                    tagFilters.style.display = "block";
                } else {
                    tagFilters.style.display = "none";
                }

                if (category === "character") {
                    characterFilters.style.display = "block";
                } else {
                    characterFilters.style.display = "none";
                }
            }

            categorySelect.addEventListener("change", updateFilterVisibility);

            updateFilterVisibility();
        });
    </script>
}