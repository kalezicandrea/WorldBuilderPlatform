@{
    ViewBag.Title = "Create Character";
}

<div class="container mt-4">

    <h2>Create Character</h2>

    <p class="text-muted">
        Universe: @ViewBag.UniverseName
    </p>

    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Create", "Characters", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        <input type="hidden" name="universeId" value="@ViewBag.UniverseId" />

        <div class="card mb-4">

            <div class="card-header">
                <h4>Character information</h4>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4">

                        <div class="mb-3">
                            <img src="@Url.Content("~/Content/ImagesDesign/default-character.jpg")"
                                 alt="Default character image"
                                 class="img-fluid rounded"
                                 style="width: 100%; max-height: 320px; object-fit: cover;" />
                        </div>

                        <div class="form-group">
                            <label for="mainImage">Main image</label>
                            <input type="file"
                                   name="mainImage"
                                   id="mainImage"
                                   class="form-control" />
                        </div>

                        <small class="text-muted">
                            Allowed formats: JPG, JPEG, PNG, WEBP. Max size: 5 MB.
                        </small>

                    </div>

                    <div class="col-md-8">

                        <div class="form-group mb-3">
                            <label for="name">Character name</label>
                            <input type="text"
                                   name="name"
                                   id="name"
                                   class="form-control"
                                   placeholder="Enter character name" />
                        </div>

                        <div class="form-group mb-3">
                            <label for="gender">Gender</label>
                            <input type="text"
                                   name="gender"
                                   id="gender"
                                   class="form-control"
                                   placeholder="Enter gender" />
                        </div>

                        <div class="form-group mb-3">
                            <label for="speciesName">Species</label>
                            <input type="text"
                                   name="speciesName"
                                   id="speciesName"
                                   class="form-control"
                                   placeholder="Enter species, for example Human, Elf, Dragon..." />
                        </div>

                        <div class="form-group mb-3">
                            <label for="speciesDescription">Species description</label>
                            <textarea name="speciesDescription"
                                      id="speciesDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe this species..."></textarea>
                        </div>

                        <div class="form-group mb-3">
                            <label for="description">Character description</label>
                            <textarea name="description"
                                      id="description"
                                      class="form-control"
                                      rows="8"
                                      placeholder="Describe your character..."></textarea>
                        </div>

                    </div>

                </div>

            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    Create Character
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Details",
                    "Universes",
                    new { id = ViewBag.UniverseId },
                    new { @class = "btn btn-secondary" }
                )
            </div>

        </div>
    }

</div>