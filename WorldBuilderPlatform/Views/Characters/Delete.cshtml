@model WorldBuilderPlatform.Character

@{
    ViewBag.Title = "Delete Character";
}

<h2>Delete Character</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this character?
</div>

<div class="card mb-4">
    <div class="card-header">
        <h4>@Model.name</h4>
    </div>

    <div class="card-body">
        <p>@Model.description</p>
    </div>

    <div class="card-footer">
        @using (Html.BeginForm("DeleteConfirmed", "Characters", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.character_id" />

            <button type="submit" class="btn btn-danger">Delete</button>

            @Html.ActionLink(
                "Cancel",
                "Details",
                "Universes",
                new { id = Model.universe_id },
                new { @class = "btn btn-secondary" }
            )
        }
    </div>
</div>