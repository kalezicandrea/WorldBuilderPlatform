@model WorldBuilderPlatform.CharacterRelationship

@{
    ViewBag.Title = "Delete Character Relationship";
}

<div class="container mt-4">

    <h2>Delete Character Relationship</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this relationship?
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h4>Relationship</h4>
        </div>

        <div class="card-body">
            <p>
                <strong>First character:</strong> @Model.Character.name
            </p>

            <p>
                <strong>Relationship type:</strong> @Model.relation_type
            </p>

            <p>
                <strong>Second character:</strong> @Model.Character1.name
            </p>
        </div>

        <div class="card-footer">
            @using (Html.BeginForm("DeleteConfirmed", "CharacterRelationships", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.relationship_id" />
                <input type="hidden" name="universeId" value="@ViewBag.UniverseId" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                @Html.ActionLink(
                    "Cancel",
                    "Details",
                    "Universes",
                    new { id = ViewBag.UniverseId },
                    new { @class = "btn btn-secondary" }
                )
            }
        </div>
    </div>

</div>